{
  "name": "cocoplus",
  "version": "2.0.0",
  "description": "CocoPlus — Agentic Operating System for Snowflake Coco",
  "author": {
    "name": "sgsshankar, viveksrinivasanss"
  },
  "license": "MIT",
  "entry": ".cortex/",
  "minCocoVersion": "1.1.1",
  "runtime": "node",
  "cocoHarvest": {
    "pullThreshold": 8000,
    "stallDetection": {
      "stallTokenThreshold": 150,
      "stallMinSteps": 5
    }
  },
  "templates": [
    "templates/AGENTS.md.template",
    "templates/project.md.template",
    "templates/flow.json.template",
    "templates/notifications.json.template",
    "templates/safety-config.json.template",
    "templates/flow-view.html.template",
    "templates/meter-view.html.template",
    "templates/cocoplus.toml.template",
    "templates/monitors/narrator.monitor.json",
    "templates/monitors/cost-tracker.monitor.json",
    "templates/monitors/quality-advisor.monitor.json",
    "templates/monitors/memory-capture.monitor.json"
  ],
  "recipes": [
    "recipes/cortex-add-classifier.json.template",
    "recipes/cortex-add-search.json.template",
    "recipes/cortex-semantic-model.json.template",
    "recipes/cortex-add-extraction.json.template"
  ],
  "agents": [
    "./.cortex/agents"
  ],
  "skills": [
    "./.cortex/skills"
  ],
  "scripts": [
    ".cortex/scripts/_contract-hash.js",
    ".cortex/scripts/adapter-self-test.js",
    ".cortex/scripts/alignment-check.js",
    ".cortex/scripts/archetype-classifier.js",
    ".cortex/scripts/artifact-check.js",
    ".cortex/scripts/audit-ci.js",
    ".cortex/scripts/audit-events.js",
    ".cortex/scripts/behavior-maturity.js",
    ".cortex/scripts/chargeback-refresh.js",
    ".cortex/scripts/cocoplus-console.js",
    ".cortex/scripts/complexity-estimate.js",
    ".cortex/scripts/contract-gate.js",
    ".cortex/scripts/contract-prove.js",
    ".cortex/scripts/cost-center-resolver.js",
    ".cortex/scripts/cupper-capture.js",
    ".cortex/scripts/dora-metrics.js",
    ".cortex/scripts/flow-event-reader.js",
    ".cortex/scripts/grove-score.js",
    ".cortex/scripts/health-grader.js",
    ".cortex/scripts/invoice-generator.js",
    ".cortex/scripts/lean-debt.js",
    ".cortex/scripts/lean-review.js",
    ".cortex/scripts/map-reduce.js",
    ".cortex/scripts/meter-reconcile.js",
    ".cortex/scripts/model-tier-resolve.js",
    ".cortex/scripts/noop-check.js",
    ".cortex/scripts/ops-suggest.js",
    ".cortex/scripts/ops-thesis-updater.js",
    ".cortex/scripts/pivot-merge.js",
    ".cortex/scripts/pr-complexity.js",
    ".cortex/scripts/recall-import.js",
    ".cortex/scripts/recipe-metadata.js",
    ".cortex/scripts/refine-reflect.js",
    ".cortex/scripts/refine-update.js",
    ".cortex/scripts/report-export.js",
    ".cortex/scripts/rollback.js",
    ".cortex/scripts/scope-classify.js",
    ".cortex/scripts/sentinel-pregate.js",
    ".cortex/scripts/session-indexer.js",
    ".cortex/scripts/shadow-report.js",
    ".cortex/scripts/sketch-autolayout.js",
    ".cortex/scripts/sketch-repair.js",
    ".cortex/scripts/sketch-validate.js",
    ".cortex/scripts/spec-validator.js",
    ".cortex/scripts/status-envelope-check.js",
    ".cortex/scripts/status-healer.js",
    ".cortex/scripts/trace-blast.js",
    ".cortex/scripts/trace-check.js",
    ".cortex/scripts/transcript-adapter.js",
    ".cortex/scripts/wisdom-route.js",
    ".cortex/scripts/wisdom-writer.js"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.cortex/hooks/session-start.js\"",
            "timeout": 60,
            "enabled": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.cortex/hooks/session-end.js\"",
            "timeout": 60,
            "enabled": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.cortex/hooks/pre-tool-use.js\"",
            "timeout": 60,
            "enabled": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.cortex/hooks/post-tool-use.js\"",
            "timeout": 60,
            "enabled": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.cortex/hooks/user-prompt-submit.js\"",
            "timeout": 60,
            "enabled": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.cortex/hooks/stop.js\"",
            "timeout": 60,
            "enabled": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.cortex/hooks/subagent-stop.js\"",
            "timeout": 60,
            "enabled": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.cortex/hooks/pre-compact.js\"",
            "timeout": 60,
            "enabled": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.cortex/hooks/notification.js\"",
            "timeout": 60,
            "enabled": true
          }
        ]
      }
    ]
  }
}
